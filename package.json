{
  "name": "unvirtual-display",
  "desktopName": "unvirtual-display.desktop",
  "version": "0.1.0",
  "description": "A local-first desktop display case for 3D figures and 2D collectibles.",
  "main": "./out/main/index.js",
  "author": "Unvirtual Display",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "dist:all": "npm run build && electron-builder --mac --win"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@pixiv/three-vrm": "3.5.5",
    "clipper2-ts": "^2.0.1-18",
    "fflate": "0.8.2",
    "i18next": "26.3.6",
    "lucide-react": "^1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "three": "0.185.1",
    "three-viewport-gizmo": "^2.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "3.1.0",
    "png-to-ico": "3.0.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "app-builder-lib": {
      "@noble/hashes": "1.8.0"
    }
  },
  "build": {
    "appId": "io.itch.unvirtualdisplay",
    "productName": "Unvirtual Display",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "tray-icon.ico"
      },
      {
        "from": "docs/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses/fonts",
        "to": "licenses/fonts"
      },
      {
        "from": "licenses/runtime",
        "to": "licenses/runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
